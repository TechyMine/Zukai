{
  "name": "zukai-worker",
  "version": "1.0.0",
  "type": "module",
  "description": "Zukai Fastify AI Audio Processing Worker (Gemini 1.5 + TTS)",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && node -e \"const fs=require('fs'); fs.cpSync('src', 'dist', { recursive: true, filter: (s) => !s.endsWith('.ts') })\"",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:e2e": "tsx src/scripts/testEndToEnd.ts",
    "eval": "tsx eval/runEval.ts",
    "eval:full": "tsx eval/evalRunner.ts",
    "eval:smoke": "tsx eval/evalRunner.ts --smoke",
    "eval:gate": "tsx eval/evalRunner.ts --gate",
    "feedback:report": "tsx src/scripts/feedbackReport.ts",
    "doctor": "tsx src/scripts/doctor.ts",
    "jobs:requeue": "tsx src/scripts/requeueJobs.ts",
    "job:inspect": "tsx src/scripts/inspectJob.ts",
    "job:replay": "tsx src/scripts/replayJob.ts",
    "eval:pipeline": "tsx eval/pipelineEvalRunner.ts",
    "quota:status": "tsx src/scripts/quotaStatus.ts",
    "load:test": "tsx src/scripts/loadTest.ts",
    "chaos": "tsx src/scripts/chaos.ts",
    "audit:fake-audio": "tsx src/scripts/auditFakeAudio.ts",
    "backfill:peaks": "tsx src/scripts/backfillWaveformPeaks.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@supabase/supabase-js": "^2.45.4",
    "@types/adm-zip": "^0.5.8",
    "adm-zip": "^0.6.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "mammoth": "^1.8.0",
    "nodemon": "^3.1.14",
    "pdf-parse": "^1.1.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pdf-parse": "^1.1.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
